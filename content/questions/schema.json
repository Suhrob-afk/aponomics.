{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aponomics.org/schemas/practice-question-batch.json",
  "title": "aponomics practice question batch",
  "description": "Original AP Microeconomics / Macroeconomics MCQs. Validated by scripts/import-questions.ts, which is the source of truth.",
  "type": "object",
  "required": ["questions"],
  "properties": {
    "$schema": { "type": "string" },
    "batch": { "type": "string" },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "number", "minimum": 0 }, { "type": "number", "minimum": 0 }],
      "minItems": 2,
      "maxItems": 2
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 16 },
    "axis": {
      "type": "object",
      "required": ["label", "max"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "ticks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": { "value": { "type": "number", "minimum": 0 }, "label": { "$ref": "#/$defs/label" } },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "required": ["xAxis", "yAxis", "curves"],
      "properties": {
        "xAxis": { "$ref": "#/$defs/axis" },
        "yAxis": { "$ref": "#/$defs/axis" },
        "curves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "points"],
            "properties": {
              "label": { "$ref": "#/$defs/label" },
              "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } },
              "smooth": { "type": "boolean" },
              "dashed": { "type": "boolean" },
              "tone": { "enum": ["primary", "secondary", "neutral"] }
            },
            "additionalProperties": false
          }
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number", "minimum": 0 },
              "y": { "type": "number", "minimum": 0 },
              "label": { "$ref": "#/$defs/label" },
              "guides": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "points"],
            "properties": {
              "label": { "$ref": "#/$defs/label" },
              "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": ["course", "unit", "topic", "difficulty", "stem", "options", "correct", "explanation", "option_explanations"],
      "properties": {
        "course": { "enum": ["micro", "macro"] },
        "unit": { "type": "integer", "minimum": 1, "maximum": 6 },
        "topic": { "$ref": "#/$defs/nonEmpty" },
        "difficulty": { "enum": [1, 2, 3] },
        "stem": { "type": "string", "minLength": 15 },
        "options": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/nonEmpty" } },
        "correct": { "enum": ["A", "B", "C", "D"] },
        "explanation": { "type": "string", "minLength": 20 },
        "option_explanations": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/nonEmpty" } },
        "graph": { "$ref": "#/$defs/graph" },
        "image_url": { "type": "string", "pattern": "^https://" },
        "image_alt": { "type": "string", "minLength": 10 },
        "source_note": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
